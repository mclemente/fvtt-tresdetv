<section
	class="character-stats"
	aria-label="Atributos e recursos do personagem"
>
	<header class="character-stats-header">
		<div class="stats-heading">
			<span class="stats-heading-title">
				Atributos
			</span>

			<span class="stats-heading-description">
				Clique em P, H ou R para fazer um teste
			</span>
		</div>

		<div class="resources-heading">
			<span>
				Recursos
			</span>

			<small>
				Atual / Máximo
			</small>
		</div>
	</header>

	{{!-- Poder e Pontos de Ação --}}
	<div class="ability stat-row stat-poder">
		<div class="stat-attribute">
			<div
				class="dados stat-roll-buttons"
				aria-label="Quantidade de dados para Poder"
			>
				<button
					type="button"
					class="rollable stat-roll-button"
					data-key="poder"
					data-dice="1"
					aria-label="Rolar um dado de Poder"
					data-tooltip="Rolar 1D + Poder"
					data-tooltip-direction="UP"
				>
					1D
				</button>

				<button
					type="button"
					class="rollable stat-roll-button"
					data-key="poder"
					data-dice="2"
					aria-label="Rolar dois dados de Poder"
					data-tooltip="Rolar 2D + Poder"
					data-tooltip-direction="UP"
				>
					2D
				</button>

				<button
					type="button"
					class="rollable stat-roll-button"
					data-key="poder"
					data-dice="3"
					aria-label="Rolar três dados de Poder"
					data-tooltip="Rolar 3D + Poder"
					data-tooltip-direction="UP"
				>
					3D
				</button>
			</div>

			<label
				class="rollable stat-attribute-label"
				for="attribute-power-{{actor.id}}"
				data-key="poder"
				data-tooltip="TRESDETV.Atributos.poder.label"
				data-tooltip-direction="UP"
				aria-label="Rolar teste de Poder"
			>
				<span class="stat-letter">
					P
				</span>

				<span class="stat-name">
					Poder
				</span>
			</label>

			<input
				id="attribute-power-{{actor.id}}"
				class="stat-value"
				type="number"
				name="system.atributos.poder.value"
				value="{{system.atributos.poder.value}}"
				data-dtype="Number"
			/>
		</div>

		<div class="stat-resource resource-action">
			<label
				class="stat-resource-label"
				for="resource-action-current-{{actor.id}}"
				data-tooltip="TRESDETV.Pontos.acao.label"
				data-tooltip-direction="UP"
			>
				<span class="resource-short">
					PA
				</span>

				<span class="resource-name">
					Ação
				</span>
			</label>

			<div class="resource-value-group">
				<input
					id="resource-action-current-{{actor.id}}"
					class="resource-current"
					type="number"
					name="system.pontos.acao.value"
					value="{{system.pontos.acao.value}}"
					data-dtype="Number"
					data-tooltip="Pontos de Ação atuais"
					data-tooltip-direction="UP"
				/>

				<span
					class="resource-separator"
					aria-hidden="true"
				>
					/
				</span>

				<input
					class="resource-maximum"
					type="number"
					name="system.pontos.acao.max"
					value="{{system.pontos.acao.max}}"
					data-dtype="Number"
					data-tooltip="Pontos de Ação máximos"
					data-tooltip-direction="UP"
					disabled
				/>
			</div>
		</div>
	</div>


<section class="feature-block advantages-block">
	<ol class="items-list feature-list">
		<li class="item flexrow items-header">
			<div class="item-name">
				<span class="section-title">
					Vantagens
				</span>
			</div>

			<div class="item-controls">
				<a
					class="item-control item-create"
					title="Criar Vantagem"
					data-type="vantagem"
				>
					<i class="fas fa-plus"></i>
				</a>
			</div>
		</li>

		{{#each (groupByOrigin vantagens) as |group|}}
			<li
				class="origin-divider {{group.cssClass}}"
			>
				<div class="origin-divider-label">
					<i class="{{group.icon}}"></i>

					<span>
						{{group.label}}
					</span>
				</div>

				<span class="origin-count">
					{{group.count}}
				</span>
			</li>

			{{#each group.items as |item|}}
				<li
					class="item item-detail flexrow {{#if item.isExpanded}}expanded{{/if}}"
					data-item-id="{{item._id}}"
				>
					<div
						class="item-name flexrow rollable"
					>
						<div
							class="item-image"
							tabindex="0"
							role="button"
							aria-label="{{item.name}}"
							style="background-image: url('{{item.img}}')"
						></div>

						<h4>
							{{item.name}}
						</h4>
					</div>

					<span
						class="item-cost"
						data-tooltip="Custo em pontos"
					>
						{{item.system.custo}} pt
					</span>

					<div class="item-controls">
						<a
							class="item-control item-edit"
							title="Editar Vantagem"
						>
							<i class="fas fa-edit"></i>
						</a>

						<a
							class="item-control item-delete"
							title="Excluir Vantagem"
						>
							<i class="fas fa-trash"></i>
						</a>
					</div>

					{{#if item.isExpanded}}
						{{>
							"tresdetv.item-summary"
							(lookup
								@root.expandedData
								item._id
							)
						}}
					{{/if}}
				</li>
			{{/each}}
		{{else}}
			<li class="empty-list-row">
				Nenhuma vantagem adicionada.
			</li>
		{{/each}}
	</ol>
</section>


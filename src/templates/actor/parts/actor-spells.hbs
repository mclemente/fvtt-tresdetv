<section class="techniques-panel">
	<header class="items-header techniques-main-header">
		<div class="item-name">
			<span class="section-title">
				Técnicas
			</span>
		</div>

		<div class="item-controls section-controls">
			<a
				class="item-control item-create"
				title="Criar Técnica Comum"
				data-tooltip="Criar Técnica Comum"
				data-tooltip-direction="UP"
				data-type="tecnica"
				data-categoria="comum"
			>
				<i
					class="fa-solid fa-plus"
					aria-hidden="true"
				></i>
			</a>
		</div>
	</header>

	<div class="technique-tier-list">
		{{#each
			(groupTechniquesByTier tecnicas)
			as |group|
		}}
			<section
				class="technique-tier-group {{group.cssClass}}"
				data-technique-tier="{{group.key}}"
			>
				<header class="technique-tier-header">
					<div class="technique-tier-title">
						<span class="technique-tier-icon">
							<i
								class="{{group.icon}}"
								aria-hidden="true"
							></i>
						</span>

						<div class="technique-tier-text">
							<strong>
								{{group.label}}
							</strong>

							<span>
								{{#if group.count}}
									{{group.count}}
									cadastrada(s)
								{{else}}
									Nenhuma cadastrada
								{{/if}}
							</span>
						</div>
					</div>

					<a
						class="item-control item-create technique-tier-create"
						title="Criar {{group.singular}}"
						data-tooltip="Criar {{group.singular}}"
						data-tooltip-direction="UP"
						data-type="tecnica"
						data-categoria="{{group.key}}"
					>
						<i
							class="fa-solid fa-plus"
							aria-hidden="true"
						></i>
					</a>
				</header>

				<ol class="item-list technique-items-list">
					{{#each group.items as |item|}}
						<li
							class="item technique-item {{group.cssClass}} {{#if item.isExpanded}}expanded{{/if}}"
							data-item-id="{{item._id}}"
							data-technique-tier="{{group.key}}"
						>
							<div
								class="item-name technique-item-name rollable"
							>
								<div
									class="item-image"
									tabindex="0"
									role="button"
									aria-label="{{item.name}}"
									style="background-image: url('{{item.img}}')"
								></div>

								<div class="technique-item-text">
									<h4>
										{{item.name}}
									</h4>

									<span class="technique-tier-badge">
										<i
											class="{{group.icon}}"
											aria-hidden="true"
										></i>

										<span>
											{{group.singular}}
										</span>
									</span>
								</div>
							</div>

							{{#if item.system.ativacao.custo}}
								<span
									class="technique-cost"
									data-tooltip="Custo de ativação"
									data-tooltip-direction="UP"
								>
									{{item.system.ativacao.custo}}PM
								</span>
							{{/if}}

							<div
								class="item-controls technique-item-controls"
							>
								<a
									class="item-control item-edit"
									title="Editar {{group.singular}}"
									data-tooltip="Editar {{group.singular}}"
									data-tooltip-direction="UP"
								>
									<i
										class="fa-solid fa-pen-to-square"
										aria-hidden="true"
									></i>
								</a>

								<a
									class="item-control item-delete"
									title="Excluir {{group.singular}}"
									data-tooltip="Excluir {{group.singular}}"
									data-tooltip-direction="UP"
								>
									<i
										class="fa-solid fa-trash"
										aria-hidden="true"
									></i>
								</a>
							</div>

							{{#if item.isExpanded}}
								{{>
									"tresdetv.item-summary"
									(lookup
										@root.expandedData
										item._id
									)
								}}
							{{/if}}
						</li>
					{{else}}
						<li
							class="empty-list-row technique-empty-row"
						>
							Nenhum item nesta categoria.
						</li>
					{{/each}}
				</ol>
			</section>
		{{/each}}
	</div>
</section>
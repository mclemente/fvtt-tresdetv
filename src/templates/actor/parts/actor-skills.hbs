<ol class="items-list">
	<li class="item flexrow items-header">
		<div class="item-name">Perícias</div>
		<div class="item-controls">
			<a class="trait-selector item-controls" data-trait="pericia">
				<i class="fas fa-edit"></i>
			</a>
		</div>
	</li>
	<div class="traits-list">
		{{#if pericias.selected}}
			{{#each pericias.selected as |v k|}}
				<li class="tag {{k}}">{{v}}</li>
			{{/each}}
		{{else}}
			<li class="tag empty">Nenhuma perícia selecionada ainda.</li>
		{{/if}}
	</div>
</ol>